[Unit]
Description=EntPay Agent payment service
After=network-online.target entcoin-seed.service entcoin-node.service
Wants=network-online.target

[Service]
Type=simple
User=entpay
Group=entpay
EnvironmentFile=/etc/entpay/entpay.env
ExecStart=/opt/entpay/entpay serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/entpay
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
